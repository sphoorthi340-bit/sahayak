# Sahayak Environment Variables — copy to .env and fill in

# ── Backend ───────────────────────────────────────────────
# Serial port where the Base Station ESP32 is connected
# Windows: COM6  |  Linux: /dev/ttyUSB0  |  WSL: /dev/ttyS6
SERIAL_PORT=COM6

# Ollama model to use — gemma4:e4b recommended for offline disaster response
# Other options: gemma4:e2b (lightest), gemma4:31b (workstation), gemma4:26b-a4b (MoE)
OLLAMA_MODEL=gemma4:e4b

# CORS origins (comma-separated, no spaces)
# Add your phone's IP when testing on local WiFi
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.137.1:5173,http://192.168.1.5:5173

# ── Frontend ──────────────────────────────────────────────
# Leave empty in production (FastAPI serves the built frontend)
# Set to http://localhost:8000 only if running frontend separately
VITE_API_URL=
